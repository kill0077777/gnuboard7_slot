# SWF/정적 파일 디렉터리에서는 서버 스크립트 실행을 허용하지 않습니다.
Options -ExecCGI -Indexes
<FilesMatch "\.(php|phtml|pht|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .pht .phar .cgi .pl .py .sh
    RemoveType .php .phtml .pht .phar .cgi .pl .py .sh
</IfModule>
